    {
      "name": "Interactions",
      "item": [
        {
          "name": "Log Interaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{JWT_TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repositoryId\": \"REPO_ID\",\n  \"type\": \"REPOSITORY_VIEW\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/interactions",
              "host": [
