datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(uuid())
  name               String
  username           String              @unique
  email              String              @unique
  avatarUrl          String?
  skills             String[]
  contributionScore  Float               @default(0.0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  oauthAccounts      OAuthAccount[]
  contributorProfile ContributorProfile?
  repositoryLikes    RepositoryLike[]
  interactions       UserInteraction[]
  interests          UserInterest[]
  imports            RepositoryImport[]
}

model OAuthAccount {
  id           String    @id @default(uuid())
  userId       String
  provider     String // e.g. "github" or "gitlab"
  providerId   String
  username     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model Repository {
  id              String   @id @default(uuid())
  name            String
  owner           String
  fullName        String
  provider        String   @default("github") // e.g. "github" or "gitlab"
  githubId        Int?     @unique
  gitlabId        Int?     @unique
  description     String?
  url             String
  languages       Json?
  frameworks      String[]
  techStack       String[]
  topics          String[]
  dependencies    Json?
  folderStructure Json?
  ciCd            String[]
  stars           Int      @default(0)
  forks           Int      @default(0)
  openIssuesCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hidden          Boolean  @default(false)

  // Language with the most bytes; drives the feed's language filter
  primaryLanguage          String?

  // Approachability signals for new contributors (refreshed on analysis)
  goodFirstIssueCount      Int       @default(0)
  helpWantedCount          Int       @default(0)
  hasContributingGuide     Boolean   @default(false)
  archived                 Boolean   @default(false)
  pushedAt                 DateTime?
  approachabilityUpdatedAt DateTime?

  likes           RepositoryLike[]
  imports         RepositoryImport[]
  interactions    UserInteraction[]

  @@unique([provider, fullName])
  @@index([goodFirstIssueCount])
  @@index([primaryLanguage])
}

model ContributorProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  contributionHistory  Json? // PRs, commits, issues count and details
  repositoryExperience Json? // Domains and depth mapping
  skillScore           Float    @default(0.0)
  activityScore        Float    @default(0.0)
  diversityScore       Float    @default(0.0)
  qualityScore         Float    @default(0.0)
  networkScore         Float    @default(0.0)
  overallScore         Float    @default(0.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RepositoryLike {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
}

model UserInteraction {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  action       String // e.g., REPOSITORY_VIEW, REPOSITORY_LIKE, ISSUE_VIEW, ISSUE_COMMENT, CONTRIBUTION, REPOSITORY_SAVE
  weight       Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  tag       String // language or topic name
  score     Float    @default(0.0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
}

// Repositories a user explicitly imported (as opposed to ones seeded into the
// catalogue), so "Imported Repos" is per user and removing one doesn't delete
// the shared repository row.
model RepositoryImport {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId])
}
