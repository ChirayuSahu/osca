datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(uuid())
  name               String
  username           String              @unique
  email              String              @unique
  avatarUrl          String?
  skills             String[]
  contributionScore  Float               @default(0.0)
  // Leaves the user out of Community and makes their profile private
  communityHidden    Boolean             @default(false)
  // What others see on the profile while it's visible
  profileShowScores   Boolean            @default(true)
  profileShowCalendar Boolean            @default(true)
  // Feed preferences: "first" | "some" | "experienced" tunes newcomer-friendliness
  // against popularity; preferred languages are boosted, excluded ones dropped
  experienceLevel    String              @default("first")
  preferredLanguages String[]            @default([])
  excludedLanguages  String[]            @default([])
  // Default For you layout: "grid" | "focus"
  feedView           String              @default("grid")
  // Onboarding: what the user wants to work on (web, ml, devtools, ...)
  interestAreas      String[]            @default([])
  onboardedAt        DateTime?
  // Per-user multipliers on the ranking weights, learned from what they open,
  // like and hide: { content, collab, topic, keyword, stars, approachability }
  rankingTuning      Json?
  // Set when GitHub rejects the stored token (expired or revoked); the app asks
  // the user to reconnect until a new sign-in clears it
  githubTokenInvalidAt   DateTime?
  contributionsSyncedAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  oauthAccounts      OAuthAccount[]
  contributorProfile ContributorProfile?
  repositoryLikes    RepositoryLike[]
  interactions       UserInteraction[]
  interests          UserInterest[]
  imports            RepositoryImport[]
  analysisRequests   AnalysisRequest[]
  recommendationEvents RecommendationEvent[]
  contributions        Contribution[]
}

model OAuthAccount {
  id           String    @id @default(uuid())
  userId       String
  provider     String // e.g. "github" or "gitlab"
  providerId   String
  username     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model Repository {
  id              String   @id @default(uuid())
  name            String
  owner           String
  fullName        String
  provider        String   @default("github") // e.g. "github" or "gitlab"
  githubId        Int?     @unique
  gitlabId        Int?     @unique
  description     String?
  url             String
  languages       Json?
  frameworks      String[]
  techStack       String[]
  topics          String[]
  dependencies    Json?
  folderStructure Json?
  ciCd            String[]
  stars           Int      @default(0)
  forks           Int      @default(0)
  openIssuesCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hidden          Boolean  @default(false)

  // Language with the most bytes; drives the feed's language filter
  primaryLanguage          String?

  // Approachability signals for new contributors (refreshed on analysis)
  goodFirstIssueCount      Int       @default(0)
  helpWantedCount          Int       @default(0)
  hasContributingGuide     Boolean   @default(false)
  archived                 Boolean   @default(false)
  pushedAt                 DateTime?
  approachabilityUpdatedAt DateTime?
  // Whether newcomers succeed here (null until measured): share of recent PRs
  // from outside the team that were merged, how many merged in the last 90 days,
  // median hours until a maintainer first replies to an outsider's issue, and
  // starter issues nobody has claimed (no assignee, no linked PR)
  outsidePrMergeRate       Float?
  outsidePrsMerged90d      Int?
  maintainerResponseHours  Float?
  unclaimedStarterIssues   Int?
  // What the project is about: keywords from its description, topics and README
  keywords                 String[]  @default([])

  likes           RepositoryLike[]
  imports         RepositoryImport[]
  interactions    UserInteraction[]

  @@unique([provider, fullName])
  @@index([goodFirstIssueCount])
  @@index([primaryLanguage])
}

model ContributorProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  contributionHistory  Json? // PRs, commits, issues count and details
  repositoryExperience Json? // Domains and depth mapping
  skillScore           Float    @default(0.0)
  activityScore        Float    @default(0.0)
  diversityScore       Float    @default(0.0)
  qualityScore         Float    @default(0.0)
  networkScore         Float    @default(0.0)
  overallScore         Float    @default(0.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RepositoryLike {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
}

model UserInteraction {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  action       String // e.g., REPOSITORY_VIEW, REPOSITORY_LIKE, ISSUE_VIEW, ISSUE_COMMENT, CONTRIBUTION, REPOSITORY_SAVE
  weight       Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  // "Not for me" lists and the feed's exclusion filter look up by user and action
  @@index([userId, action])
  @@index([repositoryId, userId])
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  tag       String // language or topic name
  score     Float    @default(0.0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
}

// Repositories a user explicitly imported (as opposed to ones seeded into the
// catalogue), so "Imported Repos" is per user and removing one doesn't delete
// the shared repository row.
model RepositoryImport {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId])
}

// A repository a user asked OSCA to analyze, tracked from the moment it's queued
// so the Imported page can show queued, analyzing and failed ones (BullMQ forgets
// jobs after a day). Once done, the repo shows up as a RepositoryImport instead.
model AnalysisRequest {
  id           String   @id @default(uuid())
  userId       String
  url          String
  fullName     String
  status       String   @default("queued") // queued | analyzing | done | failed
  error        String?
  jobId        String?
  repositoryId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fullName])
  @@index([userId, status])
}

// What people do with recommendations: shown, opened, clicked through to GitHub,
// liked, hidden, skipped. Drives the per-user learned weights and the metrics
// script (scripts/recommendation-metrics.ts).
model RecommendationEvent {
  id           String   @id @default(uuid())
  userId       String
  type         String // impression | open | github | like | hide | unhide | skip | issue_open
  surface      String // feed | focus | issues | repository
  repositoryId String?
  issueUrl     String?
  position     Int?
  explore      Boolean  @default(false)
  // Score components when it was shown; lets a later merged PR teach the ranking
  breakdown    Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([userId, repositoryId])
}

// A public pull request a user opened, found by the daily check of their GitHub
// activity. `attributed` means OSCA showed them that repository or issue before
// they opened it, and they hadn't contributed there before: the product's goal.
model Contribution {
  id             String    @id @default(uuid())
  userId         String
  prUrl          String
  prNumber       Int
  title          String
  repoFullName   String
  repositoryId   String?
  state          String // open | merged | closed
  closesIssues   Int[]     @default([])
  attributed     Boolean   @default(false)
  // Where OSCA first showed it (feed, focus, issues, repository) and when
  surface        String?
  firstShownAt   DateTime?
  openedAt       DateTime
  mergedAt       DateTime?
  closedAt       DateTime?
  // Set once a merge has been fed to the ranking, so it's learned from once
  learnedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, prUrl])
  @@index([userId, openedAt])
  @@index([attributed, openedAt])
}
