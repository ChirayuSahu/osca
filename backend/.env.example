# Database Connection URL (e.g., PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=prefer
# Number of DB connections in pool (default 10; use 2 in dev to avoid hot-reload exhaustion)
DATABASE_POOL_SIZE=10

# Server configuration
PORT=8000
NODE_ENV=development

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# Server-side GitHub token for system jobs (repository seeding / re-analysis).
# A fine-grained PAT with read-only access to public repositories is enough.
GITHUB_TOKEN=

# JWT Config — REQUIRED in production (server throws on startup if missing)
JWT_SECRET=your_super_secret_jwt_key
# Key for encrypting users' GitHub tokens at rest (optional; derived from JWT_SECRET when unset).
# Generate with: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=
# Reverse-proxy hops to trust for client IPs. Leave 0 when the API port is exposed
# directly; set 1 behind a single proxy (nginx, Caddy, a load balancer).
TRUST_PROXY=0
# Nightly signal refresh and weekly discovery of new beginner-friendly repos, on
# GITHUB_TOKEN. Defaults to on in production and off in development.
# CATALOGUE_MAINTENANCE=true
# Ranking weights (defaults shown); per-user learned multipliers apply on top
# RECOMMENDATION_CONTENT_WEIGHT=0.35
# RECOMMENDATION_COLLAB_WEIGHT=0.1
# RECOMMENDATION_TOPIC_WEIGHT=0.1
# RECOMMENDATION_KEYWORD_WEIGHT=0.15
# RECOMMENDATION_STARS_WEIGHT=0.05
# RECOMMENDATION_APPROACHABILITY_WEIGHT=0.25
FRONTEND_URL=http://localhost:3000

# Dev-only token endpoint guard (required to call GET /auth/dev-token)
# Set a long random string here. Never set this in production.
DEV_TOKEN_SECRET=

# BullMQ queue prefix (e.g. 'dev', 'staging', 'prod')
QUEUE_PREFIX=dev

# Redis (BullMQ job queues + rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=true

# OpenRouter Configuration (for AI chat)
OPENROUTER_API_KEY=your_openrouter_api_key
# Model id on OpenRouter (default: openrouter/free) and request timeout in ms
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_TIMEOUT_MS=45000

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
